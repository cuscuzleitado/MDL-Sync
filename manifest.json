{
  "manifest_version": 3,
  "name": "MDL-Sync",
  "version": "0.1.6",
  "description": "Sincroniza automaticamente o progresso de episódios no MyDramaList enquanto você assiste.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "https://mydramalist.com/*",
    "https://clubdodorama.com/*",
    "https://www.viki.com/*",
    "https://wetv.vip/*",
    "https://kisskh.co/*",
    "https://kisskh.mx/*",
    "https://kisskh.xyz/*",
    "https://www.iq.com/*",
    "https://*.123flmsfree.com/*",
    "https://ver.123pelicula.com/*",
    "https://flixlat.com/*",
    "https://play.cuevana19.com/*",
    "https://*.dramasfree.com/*",
    "https://*.solo-latino.com/*",
    "https://tokusatsus.com/*",
    "http://localhost:8080/*",
    "https://es.cuevana4br.com/*",
    "https://video.playspelis.com/*",
    "https://lostdramas.blogspot.com/*",
    "http://127.0.0.1:17831/*",
    "https://discord.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://clubdodorama.com/episodios/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/clubdodorama.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.viki.com/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/viki.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.viki.com/*"
      ],
      "js": [
        "content/viki-skip-intro.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wetv.vip/en/play/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/wetv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kisskh.co/Drama/*",
        "https://kisskh.mx/Drama/*",
        "https://kisskh.xyz/Drama/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/kisskh.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.iq.com/play/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/iqiyi.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.123flmsfree.com/*/detail/drama/*",
        "https://ver.123pelicula.com/*/detail/drama/*",
        "https://flixlat.com/*/detail/drama/*",
        "https://play.cuevana19.com/*/detail/drama/*",
        "https://*.dramasfree.com/*/detail/drama/*",
        "https://*.solo-latino.com/*/detail/drama/*",
        "https://es.cuevana4br.com/*/detail/drama*",
        "https://video.playspelis.com/*/detail/drama/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/detail-drama-template.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tokusatsus.com/player.php*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/tokudrive.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lostdramas.blogspot.com/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/lostdramas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8080/*"
      ],
      "js": [
        "sites.js",
        "content/common.js",
        "content/vlc-web.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MDL-Sync"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
